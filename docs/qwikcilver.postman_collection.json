      "name": "1. ServerAuthenticationToken (/authorize)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-connector",
            "value": "qwikcilver"
          },
          {
            "key": "x-connector-config",
            "value": "{\"config\":{\"Qwikcilver\":{\"bootstrap_bearer_token\":\"{{bootstrap_bearer_token}}\",\"terminal_id\":\"{{terminal_id}}\",\"username\":\"{{username}}\",\"password\":\"{{password}}\"}}}"
          },
          {
            "key": "x-merchant-id",
            "value": "{{merchant_id}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenant_id}}"
          },
          {
            "key": "x-request-id",
            "value": "pm-{{$timestamp}}-{{$randomInt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"merchant_request_id\": \"{{$timestamp}}\",\n  \"connector_feature_data\": \"{\\\"date_at_client\\\":\\\"{{date_at_client}}\\\"}\",\n  \"test_mode\": true\n}"
        },
        "url": {
          "raw": "{{prism_host}}/payments/server_authentication_token",
          "host": [
            "{{prism_host}}"
