  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set a fresh ISO-8601 timestamp on every send. The Qwikcilver connector",
          "// hard-requires `connector_feature_data.date_at_client` and we don't",
          "// rely on Postman's built-in {{$isoTimestamp}} since older client",
          "// versions don't substitute it.",
          "pm.collectionVariables.set('date_at_client', new Date().toISOString());"
        ]
      }
    }
