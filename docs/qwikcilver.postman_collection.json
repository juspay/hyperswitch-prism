    {
      "id": "d80ad8c3-3791-4a54-80cc-c070525457d9",
      "name": "2. Composite Authorize — Redeem",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-connector",
            "value": "qwikcilver"
          },
          {
            "key": "x-connector-config",
            "value": "{\"config\":{\"Qwikcilver\":{\"bootstrap_bearer_token\":\"{{bootstrap_bearer_token}}\",\"terminal_id\":\"{{terminal_id}}\",\"username\":\"{{username}}\",\"password\":\"{{password}}\"}}}"
          },
          {
            "key": "x-merchant-id",
            "value": "{{merchant_id}}"
          },
          {
            "key": "x-tenant-id",
            "value": "{{tenant_id}}"
          },
          {
            "key": "x-request-id",
            "value": "pm-{{$timestamp}}-{{$randomInt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"merchant_transaction_id\": \"{{$timestamp}}\",\n  \"merchant_order_id\": \"qc-redeem-{{$timestamp}}\",\n  \"merchant_request_id\": \"{{$timestamp}}\",\n  \"amount\": {\n    \"minor_amount\": 20,\n    \"currency\": \"AED\"\n  },\n  \"payment_method\": {\n    \"payment_method\": {\n      \"qwikcilver_wallet_direct\": {\n        \"wallet_number\": \"{{wallet_number}}\"\n      }\n    }\n  },\n  \"address\": {\n    \"shipping_address\": {},\n    \"billing_address\": {}\n  },\n  \"auth_type\": \"NO_THREE_DS\",\n  \"order_details\": [],\n  \"description\": \"postman e2e redeem\",\n  \"connector_feature_data\": \"{\\\"date_at_client\\\":\\\"{{date_at_client}}\\\"}\",\n  \"test_mode\": true\n}"
        },
        "url": {
          "raw": "{{prism_host}}/composite/payments/authorize",
          "host": [
            "{{prism_host}}"
          ],
          "path": [
            "composite",
            "payments",
            "authorize"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Authorize response: txn lives in connector_transaction_id; batch lives in connector_feature_data",
              "// (the framework surfaces our Rust connector_metadata as the proto connector_feature_data field).",
              "// Capture both so Refund can re-supply them.",
              "if (pm.response.code === 200) {",
              "  const r = pm.response.json();",
              "  const ar = r && r.authorize_response;",
              "  if (ar) {",
              "    const txn = ar.connector_transaction_id;",
              "    if (txn) {",
              "      pm.collectionVariables.set(\"original_transaction_id\", txn);",
              "      console.log(\"original_transaction_id =\", txn);",
              "    }",
              "    const fd = ar.connector_feature_data;",
              "    let batch = null;",
              "    if (typeof fd === \"string\") { try { batch = JSON.parse(fd).batch_number; } catch (e) {} }",
              "    else if (fd && typeof fd === \"object\") { batch = fd.batch_number; }",
              "    if (batch !== null && batch !== undefined) {",
              "      pm.collectionVariables.set(\"original_batch_number\", String(batch));",
              "      console.log(\"original_batch_number =\", batch);",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
