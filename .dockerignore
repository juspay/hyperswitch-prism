# Ignore build artifacts
target/
**/target/

# Keep version-control metadata in the builder context. The Rust build scripts
# use it to populate the compile-time VERGEN_* version fields.

# Local environment files and credential material
**/.env
**/.env.*
!**/.env.example
**/cred*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks

# Local logs, database extracts, and generated investigation artifacts
**/*.log
**/*.jsonl
**/*.sql
**/temp.*
/*.csv
/*.json
/*.md
/*.txt

# Only the supported runtime configuration files enter the build context
config/*
!config/development.toml
!config/production.toml
!config/sandbox.toml
!config/superposition.toml

# sccache cache
.sccache/
sccache/

# Cargo Chef recipe file
recipe.json

# IDE/editor files
.vscode/
.idea/
*.swp

# Docker-related
Dockerfile*
.dockerignore

# Miscellaneous
# Cargo.lock

# Example
examples/
