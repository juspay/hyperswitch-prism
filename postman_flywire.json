{
  "info": {
    "name": "Flywire — Composite HTTP (Verified E2E)",
    "description": "Verified end-to-end against Flywire sandbox (recipient ZENDD). Run against local UCS with CS__SERVER__TYPE=http on port 8000.\n\nFull flow:\n  1a. CompositeAuthorize (initial) → internally calls Authenticate → creates Flywire checkout session → REDIRECT_REQUIRED + iframe HTML\n  1b. [User opens hosted form URL and completes payment]\n  2.  CompositeAuthorize (post-redirect) → internally calls VerifyRedirectResponse + Authorize confirm → COMPLETED / CHARGED\n  3.  CompositeGet (PSync) → polls Flywire payment status → CHARGED / guaranteed\n  4.  CompositeRefund → submits refund against payment_id\n\nKey JSON gotcha: payment_method requires double nesting because the outer PaymentMethod proto message wraps a field also named payment_method containing the oneof:\n  { \"payment_method\": { \"payment_method\": { \"card_redirect\": { \"type\": \"CARD_REDIRECT\" } } } }",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8000" },
    { "key": "connector_config",  "value": "{\"config\":{\"Flywire\":{\"api_key\":\"<REDACTED>\",\"recipient_id\":\"ZENDD\",\"base_url\":\"https://api-platform-sandbox.flywire.com\"}}}" },
    { "key": "merchant_txn_id",   "value": "fw-txn-001" },
    { "key": "merchant_order_id", "value": "fw-order-001" },
    { "key": "session_id",        "value": "" },
    { "key": "payment_id",        "value": "" }
  ],
  "item": [
    {
      "name": "1a. CompositeAuthorize — Initial (Authenticate leg) → REDIRECT_REQUIRED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "",
              "pm.test('composite_status is REDIRECT_REQUIRED', () => {",
              "    pm.expect(res.composite_status).to.eql('REDIRECT_REQUIRED');",
              "});",
              "pm.test('authenticate_response present', () => {",
              "    pm.expect(res.authenticate_response).to.be.an('object');",
              "});",
              "pm.test('session_id returned', () => {",
              "    pm.expect(res.authenticate_response.connector_transaction_id).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('iframe HTML contains hosted form URL', () => {",
              "    const html = res.authenticate_response?.redirection_data?.form_type?.Html?.html_data;",
              "    pm.expect(html).to.include('flywireFrame');",
              "    pm.expect(html).to.include('elements.demo.flywire.com');",
              "});",
              "",
              "// Auto-populate session_id for step 2",
              "const sid = res.authenticate_response?.connector_transaction_id;",
              "if (sid) {",
              "    pm.collectionVariables.set('session_id', sid);",
              "    console.log('session_id set to:', sid);",
              "}",
              "",
              "// Log the hosted form URL — open this in a browser to complete payment",
              "try {",
              "    const raw = JSON.parse(res.authenticate_response.raw_connector_response);",
              "    const url = raw.hosted_form?.url;",
              "    console.log('>>> Open in browser to complete payment:', url);",
              "} catch(e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",       "value": "application/json" },
          { "key": "x-connector",        "value": "flywire" },
          { "key": "x-auth",             "value": "header-key" },
          { "key": "x-tenant-id",        "value": "public" },
          { "key": "x-request-id",       "value": "fw-initial-{{$randomUUID}}" },
          { "key": "x-connector-config", "value": "{{connector_config}}" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"merchant_transaction_id\": \"{{merchant_txn_id}}\",\n  \"merchant_order_id\": \"{{merchant_order_id}}\",\n  \"amount\": { \"minor_amount\": 100, \"currency\": \"USD\" },\n  \"payment_method\": { \"payment_method\": { \"card_redirect\": { \"type\": \"CARD_REDIRECT\" } } },\n  \"auth_type\": \"NO_THREE_DS\",\n  \"capture_method\": \"AUTOMATIC\",\n  \"return_url\": \"https://example.com/return\",\n  \"order_details\": [],\n  \"address\": {\n    \"billing_address\": {\n      \"first_name\": \"Test\",\n      \"last_name\": \"User\",\n      \"line1\": \"123 Test St\",\n      \"city\": \"London\",\n      \"country_alpha2_code\": \"GB\",\n      \"zip_code\": \"SW1A 1AA\",\n      \"email\": \"test@example.com\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/composite/payments/authorize",
          "host": ["{{base_url}}"],
          "path": ["composite", "payments", "authorize"]
        }
      },
      "response": [
        {
          "name": "200 OK — REDIRECT_REQUIRED (verified)",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"composite_status\": \"REDIRECT_REQUIRED\",\n  \"authenticate_response\": {\n    \"connector_transaction_id\": \"601863c7-f170-4c75-9ce9-c1316d6daf89\",\n    \"status\": \"PENDING\",\n    \"status_code\": 201,\n    \"response_headers\": {},\n    \"redirection_data\": {\n      \"form_type\": {\n        \"Html\": {\n          \"html_data\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\" />\\n  <title>Flywire Payment Listener</title>\\n  <style>\\n    body { margin: 0; font-family: Arial, sans-serif; }\\n    h2 { text-align: center; padding: 16px; }\\n    iframe { width: 100%; height: calc(100vh - 70px); border: none; }\\n  </style>\\n</head>\\n<body>\\n  <h2>Flywire Payment</h2>\\n  <iframe id=\\\"flywireFrame\\\" src=\\\"https://elements.demo.flywire.com/v1/form?session_id=601863c7-f170-4c75-9ce9-c1316d6daf89\\\" allow=\\\"payment\\\"></iframe>\\n  <script>\\n    window.addEventListener('message', (event) => {\\n      if (!event.origin.endsWith('.flywire.com')) return;\\n      const result = event.data;\\n      if (result.success) window.location.href = 'https://example.com/return';\\n      else if (result.success === false) window.location.href = 'https://example.com/return';\\n    });\\n  </script>\\n</body>\\n</html>\"\n        }\n      }\n    },\n    \"raw_connector_response\": \"{\\\"id\\\":\\\"601863c7-f170-4c75-9ce9-c1316d6daf89\\\",\\\"expires_in_seconds\\\":1800,\\\"hosted_form\\\":{\\\"url\\\":\\\"https://elements.demo.flywire.com/v1/form?session_id=601863c7-f170-4c75-9ce9-c1316d6daf89\\\"},\\\"warnings\\\":[]}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "1b. [Manual] Open hosted form URL in browser — complete payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// This is a documentation-only placeholder.",
              "// After step 1a, the console logs the hosted form URL.",
              "// Open it in a browser, complete the payment, then run step 2."
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://elements.demo.flywire.com/v1/form?session_id={{session_id}}",
          "host": ["elements.demo.flywire.com"],
          "path": ["v1", "form"],
          "query": [{ "key": "session_id", "value": "{{session_id}}" }]
        },
        "description": "Open this URL in a browser. Log in or fill in test card details on the Flywire hosted form, then submit. Once done, return here and run step 2 (post-redirect authorize)."
      },
      "response": []
    },
    {
      "name": "2. CompositeAuthorize — Post-redirect (VerifyRedirectResponse + Authorize leg) → COMPLETED",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sid = pm.collectionVariables.get('session_id');",
              "if (!sid) {",
              "    console.warn('session_id is empty — run step 1a first, then complete the hosted form (step 1b)');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "",
              "pm.test('composite_status is COMPLETED', () => {",
              "    pm.expect(res.composite_status).to.eql('COMPLETED');",
              "});",
              "pm.test('authorize_response status is CHARGED', () => {",
              "    pm.expect(res.authorize_response?.status).to.eql('CHARGED');",
              "});",
              "pm.test('connector_transaction_id (payment_id) returned', () => {",
              "    pm.expect(res.authorize_response?.connector_transaction_id).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('verify_redirect_response present', () => {",
              "    pm.expect(res.verify_redirect_response).to.be.an('object');",
              "});",
              "",
              "// Auto-populate payment_id for PSync and Refund",
              "const pid = res.authorize_response?.connector_transaction_id;",
              "if (pid) {",
              "    pm.collectionVariables.set('payment_id', pid);",
              "    console.log('payment_id set to:', pid);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",       "value": "application/json" },
          { "key": "x-connector",        "value": "flywire" },
          { "key": "x-auth",             "value": "header-key" },
          { "key": "x-tenant-id",        "value": "public" },
          { "key": "x-request-id",       "value": "fw-redirect-{{$randomUUID}}" },
          { "key": "x-connector-config", "value": "{{connector_config}}" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"merchant_transaction_id\": \"{{merchant_txn_id}}\",\n  \"merchant_order_id\": \"{{merchant_order_id}}\",\n  \"amount\": { \"minor_amount\": 100, \"currency\": \"USD\" },\n  \"payment_method\": { \"payment_method\": { \"card_redirect\": { \"type\": \"CARD_REDIRECT\" } } },\n  \"auth_type\": \"NO_THREE_DS\",\n  \"capture_method\": \"AUTOMATIC\",\n  \"return_url\": \"https://example.com/return\",\n  \"order_details\": [],\n  \"connector_order_id\": \"{{session_id}}\",\n  \"redirection_response\": {\n    \"params\": \"session_id={{session_id}}&status=success\",\n    \"payload\": {}\n  },\n  \"address\": {\n    \"billing_address\": {\n      \"first_name\": \"Test\",\n      \"last_name\": \"User\",\n      \"line1\": \"123 Test St\",\n      \"city\": \"London\",\n      \"country_alpha2_code\": \"GB\",\n      \"zip_code\": \"SW1A 1AA\",\n      \"email\": \"test@example.com\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/composite/payments/authorize",
          "host": ["{{base_url}}"],
          "path": ["composite", "payments", "authorize"]
        }
      },
      "response": [
        {
          "name": "200 OK — COMPLETED (verified)",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"composite_status\": \"COMPLETED\",\n  \"authorize_response\": {\n    \"merchant_transaction_id\": \"fw-live-txn-002\",\n    \"connector_transaction_id\": \"11MS6GQ8X2ZENDD\",\n    \"status\": \"CHARGED\",\n    \"status_code\": 200,\n    \"response_headers\": {},\n    \"raw_connector_response\": \"{\\\"payment_reference\\\":\\\"11MS6GQ8X2ZENDD\\\",\\\"charge_info\\\":{\\\"amount\\\":100,\\\"currency\\\":\\\"GBP\\\"},\\\"payor\\\":{\\\"country\\\":\\\"GB\\\",\\\"email\\\":\\\"test@example.com\\\"}}\"\n  },\n  \"verify_redirect_response\": {\n    \"source_verified\": false,\n    \"error\": { \"connector_details\": {} }\n  }\n}"
        }
      ]
    },
    {
      "name": "3. CompositeGet (PSync) → CHARGED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "",
              "pm.test('get_response present', () => {",
              "    pm.expect(res.get_response).to.be.an('object');",
              "});",
              "pm.test('status is CHARGED', () => {",
              "    pm.expect(res.get_response?.status).to.eql('CHARGED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",       "value": "application/json" },
          { "key": "x-connector",        "value": "flywire" },
          { "key": "x-auth",             "value": "header-key" },
          { "key": "x-tenant-id",        "value": "public" },
          { "key": "x-request-id",       "value": "fw-psync-{{$randomUUID}}" },
          { "key": "x-connector-config", "value": "{{connector_config}}" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"connector_transaction_id\": \"{{payment_id}}\",\n  \"merchant_transaction_id\": \"{{merchant_txn_id}}\",\n  \"amount\": { \"minor_amount\": 100, \"currency\": \"USD\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/composite/payments/get",
          "host": ["{{base_url}}"],
          "path": ["composite", "payments", "get"]
        }
      },
      "response": [
        {
          "name": "200 OK — CHARGED (verified)",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"get_response\": {\n    \"connector_transaction_id\": \"11MS6GQ8X2ZENDD\",\n    \"merchant_transaction_id\": \"fw-live-txn-002\",\n    \"status\": \"CHARGED\",\n    \"status_code\": 200,\n    \"response_headers\": {},\n    \"amount\": { \"minor_amount\": 100, \"currency\": \"USD\" },\n    \"raw_connector_response\": \"{\\\"payment_id\\\":\\\"11MS6GQ8X2ZENDD\\\",\\\"status\\\":\\\"guaranteed\\\",\\\"status_detail\\\":\\\"guaranteed\\\",\\\"amount_from\\\":100,\\\"currency_from\\\":\\\"GBP\\\",\\\"amount_to\\\":100,\\\"currency_to\\\":\\\"SGD\\\",\\\"external_reference\\\":\\\"fw-live-txn-002\\\",\\\"payor_id\\\":null}\"\n  }\n}"
        }
      ]
    },
    {
      "name": "4. CompositeRefund",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Response is valid JSON', () => { pm.response.to.be.json; });",
              "// Note: Flywire sandbox may reject amounts below the recipient's minimum refund setting.",
              "// A successful refund returns refund_response.status = 'PENDING'."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type",       "value": "application/json" },
          { "key": "x-connector",        "value": "flywire" },
          { "key": "x-auth",             "value": "header-key" },
          { "key": "x-tenant-id",        "value": "public" },
          { "key": "x-request-id",       "value": "fw-refund-{{$randomUUID}}" },
          { "key": "x-connector-config", "value": "{{connector_config}}" }
        ],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"connector_transaction_id\": \"{{payment_id}}\",\n  \"payment_amount\": 100,\n  \"refund_amount\": { \"minor_amount\": 100, \"currency\": \"USD\" },\n  \"merchant_refund_id\": \"fw-refund-{{$randomUUID}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/composite/refunds/refund",
          "host": ["{{base_url}}"],
          "path": ["composite", "refunds", "refund"]
        }
      },
      "response": [
        {
          "name": "200 OK — PENDING (successful refund)",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"refund_response\": {\n    \"connector_transaction_id\": \"11MS6GQ8X2ZENDD\",\n    \"connector_refund_id\": \"<refund-id>\",\n    \"status\": \"PENDING\",\n    \"status_code\": 200\n  }\n}"
        },
        {
          "name": "500 — Sandbox minimum refund amount constraint",
          "status": "Internal Server Error",
          "code": 500,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"error\": {\n    \"message\": \"Unprocessable Entity: Validation Error (The refund amount is not within the minimum refund amount settings for the recipient)\",\n    \"code\": \"500\",\n    \"details\": {\n      \"type\": \"connector_error\",\n      \"http_status_code\": 422\n    }\n  }\n}"
        }
      ]
    }
  ]
}
