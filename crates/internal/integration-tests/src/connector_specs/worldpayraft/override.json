{
  "PaymentService/Authorize": {
    "no3ds_fail_payment": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "5555555555554444"
            },
            "card_exp_month": {
              "value": "08"
            },
            "card_exp_year": {
              "value": "30"
            },
            "card_cvc": {
              "value": "999"
            }
          }
        }
      },
      "assert": {
        "error": {
          "must_exist": true
        },
        "error.connector_details.message": {
          "equals": "DO NOT HONOR"
        },
        "error.connector_details.code": {
          "equals": "005"
        },
        "error.issuer_details.network_details.decline_code": {
          "equals": "005"
        },
        "error.issuer_details.network_details.advice_code": {
          "equals": "03"
        },
        "error.issuer_details.network_details.error_message": {
          "equals": "DO NOT HONOR"
        }
      }
    },
    "no3ds_auto_capture_credit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4012000033330026"
            }
          }
        },
        "address": {
          "billing_address": {
            "first_name": {
              "value": "Jane"
            },
            "last_name": {
              "value": "Doe"
            },
            "line1": {
              "value": "123 Main St"
            },
            "city": {
              "value": "Cincinnati"
            },
            "state": {
              "value": "Ohio"
            },
            "zip_code": {
              "value": "45201"
            },
            "country_alpha2_code": "US",
            "line2": null,
            "line3": null
          },
          "shipping_address": {
            "first_name": {
              "value": "Jane"
            },
            "last_name": {
              "value": "Doe"
            },
            "line1": {
              "value": "500 Elm St"
            },
            "city": {
              "value": "Dayton"
            },
            "state": {
              "value": "Ohio"
            },
            "zip_code": {
              "value": "45402"
            },
            "country_alpha2_code": "US",
            "line2": null,
            "line3": null
          }
        },
        "setup_future_usage": "OFF_SESSION",
        "customer_acceptance": {
          "acceptance_type": "OFFLINE"
        },
        "billing_descriptor": {
          "name": {
            "value": "ACME WIDGETS"
          },
          "city": {
            "value": "CINCINNATI"
          },
          "phone": {
            "value": "18005551234"
          }
        },
        "merchant_order_id": "ORD-1001",
        "l2_l3_data": {
          "order_info": {
            "order_details": [
              {
                "product_name": "Blue widget, large",
                "quantity": 3,
                "amount": 1250,
                "product_id": "WID-BLU-L",
                "unit_of_measure": "NMB"
              }
            ],
            "merchant_order_reference_id": "PO-7781",
            "discount_amount": 100,
            "shipping_cost": 500
          },
          "tax_info": {
            "order_tax_amount": 400
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        },
        "mandate_reference.connector_mandate_id.connector_mandate_id": {
          "equals": "4444333322221111"
        },
        "network_transaction_id": {
          "equals": "865022465575879"
        }
      }
    },
    "no3ds_manual_capture_credit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4012000033330026"
            }
          }
        },
        "enable_partial_authorization": true
      },
      "assert": {
        "status": {
          "equals": "AUTHORIZED"
        }
      }
    }
  },
  "PaymentService/SetupRecurring": {
    "setup_recurring": {
      "grpc_req": {
        "address": {
          "billing_address": {
            "state": {
              "value": "California"
            }
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "error": {
          "must_not_exist": true
        },
        "mandate_reference.connector_mandate_id.connector_mandate_id": {
          "equals": "4241212121212121"
        },
        "network_transaction_id": {
          "equals": "123456789012345"
        },
        "connector_response.additional_payment_method_data.card.payment_checks": {
          "must_exist": true
        }
      }
    }
  },
  "RecurringPaymentService/Charge": {
    "RecurringPaymentService/Charge": {
      "grpc_req": {
        "connector_recurring_payment_id": {
          "connector_mandate_id": {
            "mandate_metadata": {
              "value": "{\"expiration_date\":\"3008\",\"card_network\":\"visa\",\"network_transaction_ids\":{\"visa_transaction_id\":\"123456789012345\"}}"
            }
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
    "recurring_charge": {
      "grpc_req": {
        "connector_recurring_payment_id": {
          "connector_mandate_id": {
            "mandate_metadata": {
              "value": "{\"expiration_date\":\"3008\",\"card_network\":\"visa\",\"network_transaction_ids\":{\"visa_transaction_id\":\"123456789012345\"}}"
            }
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
    "recurring_charge_low_amount": {
      "grpc_req": {
        "connector_recurring_payment_id": {
          "connector_mandate_id": {
            "mandate_metadata": {
              "value": "{\"expiration_date\":\"3008\",\"card_network\":\"visa\",\"network_transaction_ids\":{\"visa_transaction_id\":\"123456789012345\"}}"
            }
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
    "recurring_charge_with_order_context": {
      "grpc_req": {
        "connector_recurring_payment_id": {
          "connector_mandate_id": {
            "mandate_metadata": {
              "value": "{\"expiration_date\":\"3008\",\"card_network\":\"visa\",\"network_transaction_ids\":{\"visa_transaction_id\":\"123456789012345\"}}"
            }
          }
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "error": {
          "must_not_exist": true
        }
      }
    }
  },
  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "source_verified": {
          "equals": true
        },
        "event_type": {
          "equals": "PAYMENT_INTENT_SUCCESS"
        },
        "event_status": null
      }
    },
    "payment_failed": {
      "assert": {
        "source_verified": {
          "equals": true
        },
        "event_type": {
          "equals": "PAYMENT_INTENT_FAILURE"
        },
        "event_status": null
      }
    },
    "invalid_signature": {
      "grpc_req": {},
      "assert": {
        "event_type": {
          "equals": "WEBHOOK_DISPUTE_OPENED"
        },
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null
      }
    }
  },
  "PaymentService/Capture": {
    "capture_partial_amount": {
      "assert": {
        "connector_feature_data.value": {
          "contains": "\"captured_amount\":6000"
        }
      }
    }
  }
}
