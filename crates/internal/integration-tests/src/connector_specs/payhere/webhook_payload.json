{
  "_webhook_config": {
    "signature_algorithm": "md5(merchant_id + order_id + payhere_amount + payhere_currency + status_code + upper(md5(merchant_secret))), uppercase hex",
    "signature_location": "body field md5sig (application/x-www-form-urlencoded payload)",
    "note": "PayHere webhooks are form bodies with the signature embedded in the md5sig field, so the harness cannot inject it into a header. The md5sig values below are pre-computed with merchant_secret = PayHere sandbox merchant secret; the payload is base64 for the proto bytes field."
  },
