  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.connector_transaction_id": {
          "equals": "8535296650153317"
        },
        "event_content.payments_response.status": {
          "equals": "AUTHORIZED"
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "equals": "FAILURE"
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.refunds_response.connector_refund_id": {
          "equals": "8535296650153318"
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "event_type": {
          "equals": "PAYMENT_INTENT_SUCCESS"
        }
      }
    }
  },
