  "EventService/HandleEvent": {
    "payment_succeeded": {
      "grpc_req": {},
      "assert": {
        "source_verified": {
          "equals": true
        },
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_SUCCESS",
            "PAYMENT_INTENT_AUTHORIZATION_SUCCESS"
          ]
        },
        "event_status": null,
        "event_content.payments_response": {
          "must_exist": true
        }
      }
    },
    "payment_failed": {
      "grpc_req": {},
      "assert": {
        "source_verified": {
          "equals": true
        },
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_FAILURE"
          ]
        },
        "event_status": null,
        "event_content.payments_response": {
          "must_exist": true
        }
      }
    },
    "refund_succeeded": {
      "grpc_req": {},
      "assert": {
        "source_verified": {
          "equals": true
        },
        "event_type": {
          "one_of": [
            "WEBHOOK_REFUND_SUCCESS"
          ]
        },
        "event_status": null,
        "event_content.refunds_response": {
          "must_exist": true
        }
      }
    },
    "invalid_signature": {
      "grpc_req": {},
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null,
        "event_content": {
          "must_not_exist": true
        },
        "event_ack_response": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      }
    }
  },
  "PaymentService/Capture": {
    "capture_full_amount": {
      "grpc_req": {
        "connector_feature_data": {
          "value": ""
        }
      },
      "assert": {
        "status": {
          "equals": "CHARGED"
        },
        "captured_amount": {
          "equals": 6000
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
    "capture_partial_amount": {
      "grpc_req": {
        "amount_to_capture": {
          "minor_amount": 3000
        },
        "connector_feature_data": {
          "value": ""
        }
      },
      "assert": {
        "status": {
          "equals": "PARTIAL_CHARGED"
        },
        "captured_amount": {
          "equals": 3000
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "context_map_overrides": {
        "amount_to_capture.minor_amount": "Explicit partial capture of 3000 from the authorization of 6000; captured_amount must equal3000. PayPal validates original remaining balance separately."
      }
    },
    "capture_with_merchant_order_id": {
      "grpc_req": {
        "connector_feature_data": {
          "value": ""
        }
      },
      "assert": {
        "status": {
