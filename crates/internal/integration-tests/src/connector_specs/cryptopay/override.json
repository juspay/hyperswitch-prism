{
  "PaymentService/Get": {
    "sync_payment": {
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        }
      }
    },
    "sync_payment_with_handle_response": {
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        }
      }
    }
  },
