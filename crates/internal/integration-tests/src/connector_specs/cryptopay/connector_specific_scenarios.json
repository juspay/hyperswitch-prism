{
  "PaymentService/Authorize": {
    "cryptopay_invoice": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        },
        "payment_method": {
          "crypto": {
            "pay_currency": "LTC"
          }
        },
        "capture_method": "AUTOMATIC"
      },
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "is_default": true
    },
    "cryptopay_invoice_with_metadata": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        },
        "payment_method": {
          "crypto": {
            "pay_currency": "LTC"
          }
        },
        "capture_method": "AUTOMATIC",
        "metadata": {
          "value": "{\"order_id\":\"regression-order\"}"
        }
      },
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "is_default": false
    },
    "cryptopay_invoice_with_return_url": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        },
        "payment_method": {
          "crypto": {
            "pay_currency": "LTC"
          }
        },
        "capture_method": "AUTOMATIC",
        "return_url": "https://example.com/return"
      },
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "is_default": false
    },
    "cryptopay_invoice_small_amount": {
      "grpc_req": {
        "merchant_transaction_id": "auto_generate",
        "amount": {
          "minor_amount": 1000,
          "currency": "USD"
        },
        "payment_method": {
          "crypto": {
            "pay_currency": "LTC"
          }
        },
        "capture_method": "AUTOMATIC"
      },
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      },
      "is_default": false
    }
  }
}
