    "checkout_google_pay_decrypted_pan_only_3ds": {
      "extends": "no3ds_auto_capture_google_pay_decrypted",
      "grpc_req": {
        "payment_method": {
          "google_pay_sdk": {
            "description": "Visa 4242",
            "info": {
              "card_details": "4242"
            },
            "tokenization_data": {
              "decrypted_data": {
                "cryptogram": null,
