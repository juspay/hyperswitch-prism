    "checkout_merchant_advice_code": {
      "extends": "no3ds_auto_capture_credit_card",
      "grpc_req": {
        "amount": {
          "minor_amount": 8105
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "5105105105105100"
            },
            "card_cvc": {
              "value": "100"
            }
          }
        },
        "capture_method": "MANUAL"
      },
      "assert": {
        "connector_transaction_id": null,
        "error": {
          "must_exist": true
        },
        "status": {
          "one_of": [
            "FAILURE",
            "AUTHORIZATION_FAILED"
          ]
        },
        "error.connector_details.code": {
          "equals": "20179"
        },
        "error.issuer_details.network_details.advice_code": {
          "equals": "01"
        },
        "error.issuer_details.network_details.decline_code": {
          "equals": "79"
        }
      }
