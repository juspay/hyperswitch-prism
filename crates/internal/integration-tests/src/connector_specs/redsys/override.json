  "PaymentService/Get": {
    "sync_payment": {
      "assert": {
        "status": {
          "one_of": [
            "CHARGED",
            "AUTHORIZED",
            "VOIDED",
            "PENDING",
            "AUTHENTICATION_PENDING"
          ]
        },
        "error": {
          "must_not_exist": true
        },
        "connector_transaction_id": {
          "must_exist": true
        }
      }
    },
