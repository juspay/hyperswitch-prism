    "recurring_charge_with_order_context": {
      "grpc_req": {
        "amount": {
          "currency": "EUR"
        },
        "capture_method": "MANUAL"
      },
      "assert": {
        "status": {
          "equals": "AUTHORIZED"
        }
      }
    }
