  "RecurringPaymentService/Charge": {
    "recurring_charge": {
      "grpc_req": {
        "amount": {
          "currency": "EUR"
        },
        "payment_method": {
          "token": {
            "token": {
              "value": "redsys_mit_vault_token"
            }
          }
        }
      },
      "assert": {
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
