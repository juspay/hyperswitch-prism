  "PaymentService/Authorize": {
    "no3ds_auto_capture_credit_card": {
      "grpc_req": {
        "amount": {
          "minor_amount": 2500,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4548812049400004"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_exp_year": {
              "value": "26"
            },
            "card_holder_name": {
              "value": "joseph Doe"
            },
            "card_cvc": {
              "value": "123"
            }
          }
        },
        "address": {
          "billing_address": {
            "state": {
              "value": "Ceuta"
            },
            "country_alpha2_code": "ES"
          },
          "shipping_address": {
            "state": {
              "value": "Ceuta"
            },
            "country_alpha2_code": "ES"
          }
        }
      },
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      }
    },
