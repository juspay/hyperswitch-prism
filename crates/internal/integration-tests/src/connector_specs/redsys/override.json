  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "equals": "CHARGED"
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "equals": "FAILURE"
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.refunds_response.status": {
          "equals": "REFUND_SUCCESS"
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "source_verified": {
          "must_not_exist": true
        },
        "event_type": {
          "equals": "PAYMENT_INTENT_SUCCESS"
        }
      }
    }
  }
