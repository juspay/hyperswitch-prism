{
  "PaymentService/Authorize": {
    "no3ds_fail_payment": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_exp_year": {
              "value": "98"
            }
          }
        }
      }
    }
  },
  "PaymentService/Void": {
    "void_authorized_payment": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    },
    "void_without_cancellation_reason": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    }
  },
  "PaymentService/Reverse": {
    "reverse_fail_invalid_transaction_id": {
      "assert": {
        "post_capture_void_status": {
          "one_of": [
            "POST_CAPTURE_VOID_STATUS_SUCCEEDED",
            "POST_CAPTURE_VOID_STATUS_PENDING",
            "POST_CAPTURE_VOID_STATUS_FAILED"
          ]
        },
        "error": null
      }
    }
  }
}
