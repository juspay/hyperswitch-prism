{
  "_webhook_config": {
    "webhook_secret_key": "webhook_secret",
    "signature_algorithm": "base64(hmac_sha512(webhook_secret, orderId,orderStatus,eventId,eventType,timeStamp))",
    "signature_location": "body field signature (Noon v1 JSON webhook); there is no signature header, so the harness cannot sign these bodies",
    "note": "Bodies follow the documented Noon v1 webhook shape (https://docs.noonpayments.com/). Every signature is a fixed all-zero fixture value, not derived from any secret, so these entries never verify: invalid_signature asserts that, and the other three grade event mapping without source verification."
  },
