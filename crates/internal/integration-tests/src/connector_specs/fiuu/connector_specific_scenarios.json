      "grpc_req": {
        "request_details": {
          "method": "HTTP_METHOD_POST",
          "headers": {
            "content-type": "application/json"
          },
          "body": ""
        },
        "webhook_secrets": {
          "secret": "public-regression-fixture-secret"
        },
        "merchant_event_id": "auto_generate",
