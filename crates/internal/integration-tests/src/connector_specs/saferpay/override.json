  "PaymentService/Authorize": {
    "no3ds_fail_payment": {
      "assert": {
        "error": {
          "must_exist": true
        },
        "error.error_code": {
          "contains": "CAPTURE_METHOD_NOT_SUPPORTED"
        },
        "error.connector_details.message": null
      }
    },
    "threeds_manual_capture_credit_card": {
      "assert": {
        "connector_transaction_id": {
          "must_not_exist": true
        },
        "redirection_data": null,
        "status": null,
        "error": {
          "must_exist": true
        }
      }
    }
  },
  "EventService/HandleEvent": {
    "payment_succeeded": {
      "grpc_req": {
        "merchant_event_id": "d4e5f6a7-b8c9-0123-4567-89abcdef0123"
      },
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_SUCCESS"
          ]
        },
        "event_status": null
      }
    },
    "payment_failed": {
      "grpc_req": {
        "merchant_event_id": "d4e5f6a7-b8c9-0123-4567-89abcdef0124"
      },
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_FAILURE"
          ]
        },
        "event_status": null
      }
    },
    "refund_succeeded": {
      "grpc_req": {
        "merchant_event_id": "d4e5f6a7-b8c9-0123-4567-89abcdef0125"
      },
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_type": {
          "one_of": [
            "WEBHOOK_REFUND_SUCCESS"
          ]
        },
        "event_status": null
      }
    }
  }
}
