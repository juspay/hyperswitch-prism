  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "source_verified": null,
        "event_content": {
          "must_exist": true
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "source_verified": null,
        "event_content": {
          "must_exist": true
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "source_verified": null,
        "event_content": {
          "must_exist": true
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "event_content": {
          "must_exist": true
        }
      }
    },
    "payment_status_tamper_manual_capture": {
      "extends": "payment_succeeded",
      "assert": {
        "event_status": null,
        "source_verified": null,
        "event_type": {
          "equals": "PAYMENT_INTENT_SUCCESS"
        },
        "event_content.payments_response.status": {
          "one_of": [
            "AUTHORIZED"
          ]
        }
      }
    },
    "chargeback_parent_tid_reference": {
      "extends": "payment_succeeded",
      "assert": {
        "event_status": null,
        "source_verified": null,
        "event_type": {
          "equals": "WEBHOOK_DISPUTE_OPENED"
        },
        "event_content.disputes_response.connector_dispute_id": {
          "equals": "15455000053329200"
        },
        "event_content.disputes_response.dispute_status": {
          "equals": "DISPUTE_OPENED"
        },
        "event_content.disputes_response.dispute_stage": {
          "equals": "ACTIVE_DISPUTE"
        }
      }
    }
  }
