  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_SUCCESS",
            "PAYMENT_INTENT_AUTHORIZATION_SUCCESS"
          ]
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_FAILURE"
          ]
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "event_type": {
          "one_of": [
            "WEBHOOK_REFUND_SUCCESS"
          ]
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_SUCCESS",
            "PAYMENT_INTENT_AUTHORIZATION_SUCCESS"
          ]
        }
      }
    }
  }
