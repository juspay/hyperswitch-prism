{
  "PaymentService/SetupRecurring": {
    "setup_recurring": {
      "grpc_req": { "amount": { "minor_amount": 0 }, "merchant_order_id": null },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_transaction_id": { "must_exist": true },
        "connector_feature_data": { "contains": "verification" },
        "status": { "equals": "CHARGED" }
      }
    },
    "PaymentService/SetupRecurring": {
      "grpc_req": { "amount": { "minor_amount": 0 }, "merchant_order_id": null },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_transaction_id": { "must_exist": true },
        "connector_feature_data": { "contains": "verification" },
        "status": { "equals": "CHARGED" }
      }
    },
    "setup_recurring_with_webhook": {
      "grpc_req": { "amount": { "minor_amount": 0 }, "merchant_order_id": null },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_transaction_id": { "must_exist": true },
        "connector_feature_data": { "contains": "verification" },
        "status": { "equals": "CHARGED" }
      }
    },
    "setup_recurring_with_order_context": {
      "grpc_req": { "amount": { "minor_amount": 0 }, "merchant_order_id": "JPM verification.1-1" },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_transaction_id": { "must_exist": true },
        "connector_feature_data": { "contains": "verification" },
        "status": { "equals": "CHARGED" }
      }
    }
  },
  "RecurringPaymentService/Charge": {
    "recurring_charge": {
      "grpc_req": {
        "merchant_order_id": null,
        "metadata": null,
        "connector_feature_data": null,
        "payment_method": { "card_details_for_network_transaction_id": { "card_network": "VISA" } },
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      },
      "assert": { "status": { "equals": "CHARGED" } }
    },
    "recurring_charge_variable_without_order_reference": {
      "extends": "recurring_charge",
      "grpc_req": { "mit_category": "RECURRING_MIT" }
    },
    "RecurringPaymentService/Charge": {
      "grpc_req": {
        "merchant_order_id": null,
        "payment_method": { "card_details_for_network_transaction_id": { "card_network": "VISA" } },
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
    },
    "recurring_charge_low_amount": {
      "grpc_req": {
        "merchant_order_id": null,
        "payment_method": { "card_details_for_network_transaction_id": { "card_network": "VISA" } },
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
    },
    "recurring_charge_with_order_context": {
      "grpc_req": {
        "merchant_order_id": "JPM recurring.1-1",
        "payment_method": { "card_details_for_network_transaction_id": { "card_network": "VISA" } },
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
    }
  },
  "PaymentService/Authorize": {
    "no3ds_auto_capture_credit_card": {
      "grpc_req": { "setup_future_usage": "OFF_SESSION", "merchant_order_id": null },
      "assert": { "network_transaction_id": { "must_exist": true } }
    },
    "card_cit_with_order_reference": {
      "extends": "no3ds_auto_capture_credit_card",
      "grpc_req": { "merchant_order_id": "JPM order.1-1" }
    },
    "no3ds_auto_capture_apple_pay_decrypted_cit": {
      "grpc_req": { "merchant_order_id": null },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_feature_data": { "must_not_exist": true },
        "network_transaction_id": { "must_exist": true }
      }
    },
    "no3ds_auto_capture_google_pay_decrypted_cit": {
      "grpc_req": { "merchant_order_id": null },
      "assert": {
        "mandate_reference.connector_mandate_id.connector_mandate_id": { "must_not_exist": true },
        "connector_feature_data": { "must_not_exist": true },
        "network_transaction_id": { "must_exist": true }
      }
    }
  }
}
