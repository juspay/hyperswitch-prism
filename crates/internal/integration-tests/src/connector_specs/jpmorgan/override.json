  },
  "RecurringPaymentService/Charge": {
    "recurring_charge": {
      "grpc_req": {
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
    },
    "RecurringPaymentService/Charge": {
      "grpc_req": {
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
    },
    "recurring_charge_low_amount": {
      "grpc_req": {
        "connector_recurring_payment_id": { "connector_mandate_id": null },
        "off_session": true,
        "mit_category": "UNSCHEDULED_MIT"
      }
