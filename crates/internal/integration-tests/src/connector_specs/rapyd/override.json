{
  "PaymentService/Authorize": {
    "no3ds_auto_capture_google_pay_encrypted": {
      "grpc_req": {}
    },
    "no3ds_fail_payment": {
      "grpc_req": {
        "amount": {
          "minor_amount": 200000
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4111111111111111"
            }
          }
        }
      },
      "assert": {
        "status": {
          "one_of": ["FAILURE"]
        },
        "error.connector_details.code": {
          "one_of": ["ERROR_PROCESS_PAYMENT_SETTLEMENT_DECLINED"]
        },
        "error.connector_details.message": {
          "one_of": ["ERROR"]
        },
        "error.connector_details.reason": {
          "contains": "settlement was declined"
        },
        "status_code": {
          "one_of": [400]
        }
      }
    }
  },
  "PaymentService/SetupRecurring": {
    "setup_recurring": {
      "grpc_req": {
        "return_url": "https://example.com/payment/return"
      },
      "assert": {
        "status": {
          "one_of": ["AUTHORIZED"]
        }
      }
    },
    "PaymentService/SetupRecurring": {
      "grpc_req": {
        "return_url": "https://example.com/payment/return"
      },
      "assert": {
        "status": {
          "one_of": ["AUTHORIZED"]
        }
      }
    }
  },
  "RecurringPaymentService/Charge": {
    "recurring_charge": {
      "grpc_req": {
        "return_url": "https://example.com/payment/return"
      },
      "assert": {
        "status": {
          "one_of": ["CHARGED"]
        }
      }
    },
    "RecurringPaymentService/Charge": {
      "grpc_req": {
        "return_url": "https://example.com/payment/return"
      },
      "assert": {
        "status": {
          "one_of": ["CHARGED"]
        }
      }
    },
    "recurring_charge_low_amount": {
      "grpc_req": {
        "return_url": "https://example.com/payment/return"
      },
      "assert": {
        "status": {
          "one_of": ["CHARGED"]
        }
      }
    }
  },
  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "one_of": ["CHARGED"]
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "one_of": ["FAILURE"]
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.refunds_response.status": {
          "one_of": ["REFUND_SUCCESS"]
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null,
        "event_type": {
          "one_of": ["PAYMENT_INTENT_SUCCESS"]
        }
      }
    }
  }
}
