{
  "PaymentService/Authorize": {
    "no3ds_auto_capture_debit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4751271111111118"
            }
          }
        }
      }
    },
    "no3ds_manual_capture_debit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4751271111111118"
            }
          }
        }
      }
    },
    "no3ds_auto_capture_credit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4532111111111112"
            }
          }
        }
      }
    },
    "no3ds_manual_capture_credit_card": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4532111111111112"
            }
          }
        }
      }
    },
    "no3ds_auto_capture_credit_card_without_optional_address": {
      "extends": "no3ds_auto_capture_credit_card",
      "grpc_req": {
        "address": {
          "shipping_address": null,
          "billing_address": null
        }
      }
    },
    "no3ds_auto_capture_credit_card_four_digit_expiry": {
      "extends": "no3ds_auto_capture_credit_card",
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_exp_year": {
              "value": "2030"
            }
          }
        }
      }
    },
    "no3ds_auto_capture_credit_card_two_digit_expiry": {
      "extends": "no3ds_auto_capture_credit_card"
    },
    "no3ds_manual_capture_credit_card_without_optional_address": {
      "extends": "no3ds_manual_capture_credit_card",
      "grpc_req": {
        "address": {
          "shipping_address": null,
          "billing_address": null
        }
      }
    },
    "no3ds_auto_capture_credit_card_with_setup_future_usage": {
      "extends": "no3ds_auto_capture_credit_card",
      "grpc_req": {
        "setup_future_usage": "OFF_SESSION"
      }
    },
    "no3ds_fail_payment": {
      "grpc_req": {
        "amount": {
          "minor_amount": 50
        }
      },
      "assert": {
        "error": {
          "must_exist": true
        }
      }
    }
  },
  "PaymentService/SetupRecurring": {
    "PaymentService/SetupRecurring": {
      "grpc_req": {
        "amount": {
          "minor_amount": 0
        }
      }
    },
    "setup_recurring": {
      "grpc_req": {
        "amount": {
          "minor_amount": 0
        }
      }
    },
    "setup_recurring_with_order_context": {
      "grpc_req": {
        "amount": {
          "minor_amount": 0
        }
      }
    },
    "setup_recurring_with_webhook": {
      "grpc_req": {
        "amount": {
          "minor_amount": 0
        }
      }
    }
  },
  "RecurringPaymentService/Charge": {
    "RecurringPaymentService/Charge": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": "4111111111111111",
            "card_exp_month": "08",
            "card_exp_year": "30",
            "card_cvc": "999"
          }
        }
      }
    },
    "recurring_charge": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": "4111111111111111",
            "card_exp_month": "08",
            "card_exp_year": "30",
            "card_cvc": "999"
          }
        }
      }
    },
    "recurring_charge_low_amount": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": "4111111111111111",
            "card_exp_month": "08",
            "card_exp_year": "30",
            "card_cvc": "999"
          }
        }
      }
    },
    "recurring_charge_with_order_context": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": "4111111111111111",
            "card_exp_month": "08",
            "card_exp_year": "30",
            "card_cvc": "999"
          }
        }
      }
    }
  },
  "PaymentMethodAuthenticationService/PreAuthenticate": {
    "threeds_card_pre_authenticate": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4100000000000100"
            }
          }
        }
      },
      "assert": {
        "error": {
          "must_not_exist": true
        }
      }
    }
  },
  "PaymentService/Void": {
    "void_authorized_payment": {
      "assert": {
        "status": {
          "one_of": [
            "VOID_INITIATED",
            "VOIDED",
            "PENDING"
          ]
        }
      }
    },
    "void_without_cancellation_reason": {
      "assert": {
        "status": {
          "one_of": [
            "VOID_INITIATED",
            "VOIDED",
            "PENDING"
          ]
        }
      }
    }
  },
  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "equals": "CHARGED"
        },
        "event_ack_response.status_code": {
          "equals": 200
        }
      }
    },
    "payment_failed": {
      "assert": {
        "event_status": null,
        "event_content.payments_response.status": {
          "equals": "FAILURE"
        },
        "event_ack_response.status_code": {
          "equals": 200
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "event_status": null,
        "event_content.refunds_response.status": {
          "equals": "REFUND_SUCCESS"
        },
        "event_ack_response.status_code": {
          "equals": 200
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "event_type": {
          "equals": "PAYMENT_INTENT_SUCCESS"
        },
        "event_ack_response.status_code": {
          "equals": 200
        }
      }
    }
  }
}
