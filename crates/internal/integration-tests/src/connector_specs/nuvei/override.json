  "PaymentMethodAuthenticationService/Authenticate": {
    "threeds_card_authenticate": {
      "grpc_req": {
        "browser_info": {
          "ip_address": "127.0.0.1",
          "accept_header": "application/json",
          "user_agent": "Mozilla/5.0 (integration-tests)",
          "accept_language": "en-US",
          "language": "en-US",
          "color_depth": 24,
          "screen_height": 1080,
          "screen_width": 1920,
          "java_enabled": false,
          "java_script_enabled": true,
          "time_zone_offset_minutes": -480
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4000027891380961"
            },
            "card_holder_name": {
              "value": "CL-BRW1"
            }
          }
        },
        "amount": {
          "minor_amount": 11500,
          "currency": "USD"
        },
        "capture_method": "MANUAL"
      },
      "assert": {
        "status": {
          "one_of": [
            "AUTHENTICATION_PENDING"
          ]
        },
        "redirection_data": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        }
      }
    }
  },
