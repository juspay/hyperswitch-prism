{
  "PaymentService/Authorize": {
    "no3ds_auto_capture_ach_bank_transfer": {
      "grpc_req": {
        "metadata": {
          "value": "{\"ach\":{\"account_number\":\"123456789\",\"routing_number\":\"021000021\",\"sec_code\":\"WEB\"}}"
        }
      }
    },
    "no3ds_auto_capture_eps": {
      "assert": {
        "connector_transaction_id": null
      }
    },
    "no3ds_auto_capture_giropay": {
      "assert": {
        "connector_transaction_id": null
      }
    },
    "no3ds_fail_payment": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4344141510671174"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_cvc": {
              "value": "217"
            }
          }
        }
      },
      "assert": {
        "status": {
          "one_of": ["FAILURE"]
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_exist": true
        },
        "error.connector_details.message": {
          "equals": "Do not honor"
        },
        "error.connector_details.code": {
          "equals": "-1"
        }
      }
    },
    "threeds_manual_capture_credit_card": {
      "assert": {
        "status": null,
        "connector_transaction_id": {
          "must_not_exist": true
        },
        "redirection_data": {
          "must_not_exist": true
        },
        "error": {
          "must_exist": true
        },
        "error.error_code": {
          "equals": "MISSING_REQUIRED_FIELD"
        },
        "error.error_message": {
          "contains": "connector_feature_data.related_transaction_id"
        }
      }
    }
  },
  "PaymentService/CreateOrder": {
    "create_order_basic": {
      "assert": {
        "status": {
          "one_of": ["PENDING"]
        }
      }
    },
    "create_order_with_metadata": {
      "assert": {
        "status": {
          "one_of": ["PENDING"]
        }
      }
    },
    "create_order_with_payment_method_type": {
      "assert": {
        "status": {
          "one_of": ["AUTHENTICATION_PENDING"]
        },
        "session_token": null,
        "session_data": {
          "must_exist": true
        }
      }
    }
  },
  "PaymentService/Void": {
    "void_authorized_payment": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    },
    "void_without_cancellation_reason": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    }
  },
  "PaymentMethodAuthenticationService/PostAuthenticate": {
    "threeds_card_post_authenticate": {
      "grpc_req": {
        "redirection_response": {
          "payload": {
            "cres": "eyJ0cmFuc1N0YXR1cyI6IlkifQ=="
          }
        }
      },
      "assert": {
        "status": {
          "one_of": ["AUTHENTICATION_SUCCESSFUL"]
        },
        "error": {
          "must_not_exist": true
        },
        "redirection_data": {
          "must_not_exist": true
        }
      }
    }
  }
}
