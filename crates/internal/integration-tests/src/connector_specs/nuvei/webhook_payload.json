{
  "_webhook_config": {
    "signature_body_field": "advanceResponseChecksum",
    "signature_algorithm": "nuvei_sha256_concat",
    "signature_format": "sha256(secret + totalAmount + currency + responseTimeStamp + PPP_TransactionID + Status + productId), lowercase hex, over the form-decoded values",
    "webhook_secret_key": "webhook_secret",
    "note": "Nuvei payment DMNs are form bodies with the signature in the advanceResponseChecksum field. The positive scenarios carry no checksum: the harness computes it at run time from the creds-file webhook secret and appends it. Nothing in this file is derived from a secret."
  },
  "payment_succeeded": {
    "grpc_req": {
      "request_details": {
        "method": "HTTP_METHOD_POST",
        "uri": "/webhooks/nuvei",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": ""
      },
      "merchant_event_id": "nuvei_webhook_payment_succeeded"
    }
  },
  "payment_failed": {
    "grpc_req": {
      "request_details": {
        "method": "HTTP_METHOD_POST",
        "uri": "/webhooks/nuvei",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": ""
      },
      "merchant_event_id": "nuvei_webhook_payment_failed"
    }
  },
  "refund_succeeded": {
    "grpc_req": {
      "request_details": {
        "method": "HTTP_METHOD_POST",
        "uri": "/webhooks/nuvei",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": ""
      },
      "merchant_event_id": "nuvei_webhook_refund_succeeded"
    }
  },
  "invalid_signature": {
    "grpc_req": {
      "request_details": {
        "method": "HTTP_METHOD_POST",
        "uri": "/webhooks/nuvei",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": ""
      },
      "merchant_event_id": "nuvei_webhook_invalid_signature"
    }
  }
}
