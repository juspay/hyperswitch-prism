  "PaymentService/TokenSetupRecurring": {
    "token_setup_mandate": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "metadata": {
          "value": "{\"description\":\"UCS integration test — HiPay mandate setup\",\"payment_product\":\"visa\"}"
        }
      },
      "assert": {
        "connector_transaction_id": null,
        "mandate_id": null,
        "connector_recurring_payment_id": {
          "must_exist": true
        },
        "mandate_reference.connector_mandate_id.connector_mandate_id": {
          "must_exist": true
        },
        "status": {
          "one_of": [
            "CHARGED",
            "AUTHORIZED",
            "PENDING"
          ]
        },
        "error": {
          "must_not_exist": true
        }
      }
    }
  },
  "PaymentService/Capture": {
    "capture_partial_amount": {
      "assert": {
        "connector_metadata.captured_amount": {
          "must_exist": true
        }
      }
    }
