  "PaymentService/SetupRecurring": {
    "setup_recurring": {
      "grpc_req": {
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4111111111111111"
            },
            "card_holder_name": {
              "value": "John Doe"
            }
          }
        },
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "metadata": {
          "value": "{\"description\":\"UCS integration test — HiPay mandate setup\",\"payment_product\":\"visa\"}"
        }
      }
