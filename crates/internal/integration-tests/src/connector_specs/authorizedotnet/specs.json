{
  "connector": "authorizedotnet",
  "supported_suites": [
    "CustomerService/Create",
    "PaymentService/Authorize",
    "MerchantAuthenticationService/CreateServerSessionAuthenticationToken",
    "PaymentService/Capture",
    "PaymentService/Void",
    "PaymentService/Reverse",
    "PaymentService/Refund",
    "PaymentService/Get",
    "RefundService/Get",
    "PaymentService/SetupRecurring",
    "RecurringPaymentService/Charge",
    "EventService/HandleEvent"
  ],
  "supported_payment_methods": [
    "card"
  ],
  "unsupported_scenarios": {
    "PaymentService/Authorize": {
      "threeds_manual_capture_credit_card": "Authorize.Net 3DS requires a browser-based redirect flow; no browser_automation_spec.json is configured for Authorize.Net",
      "no3ds_manual_capture_incremental_auth": "IncrementalAuthorization is not_implemented for Authorize.Net"
    }
  }
}
