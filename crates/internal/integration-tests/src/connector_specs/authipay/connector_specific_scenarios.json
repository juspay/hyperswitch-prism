{
 "PaymentMethodAuthenticationService/PostAuthenticate": {
  "post_authenticate_missing_cres": {
   "grpc_req": {
    "amount": {
     "minor_amount": 6000,
     "currency": "USD"
    },
    "payment_method": {
     "card": {
      "card_number": {
       "value": "4761340000000035"
      },
      "card_exp_month": {
       "value": "08"
      },
      "card_exp_year": {
       "value": "30"
      },
      "card_cvc": {
       "value": "999"
      },
      "card_holder_name": {
       "value": "auto_generate"
      },
      "card_type": "credit"
     }
    },
    "metadata": {
     "value": "{}"
    },
    "connector_feature_data": {
     "value": "{}"
    },
    "redirection_response": null
   },
   "assert": {
    "error": {
     "must_exist": true,
     "error_code": "INTERNAL_SERVICE_ERROR"
    }
   },
   "display_name": "Post Authenticate missing CRes refused"
  }
 },
 "PaymentMethodAuthenticationService/PreAuthenticate": {
  "preauthenticate_non_card_refused": {
   "grpc_req": {
    "merchant_order_id": "auto_generate",
    "amount": {
     "minor_amount": 6000,
     "currency": "USD"
    },
    "payment_method": {
     "upi_collect": {
      "vpa_id": {
       "value": "someone@upi"
      }
     }
    }
   },
   "assert": {
    "error": {
     "must_exist": true
    }
   },
   "display_name": "Pre Authenticate non-card payment method refused"
  }
 },
 "EventService/HandleEvent": {
  "webhook_refund_txntype_return": {
   "grpc_req": {
    "request_details": {
     "method": "HTTP_METHOD_POST",
     "headers": {
      "content-type": "application/x-www-form-urlencoded"
     },
     "body": ""
    },
    "merchant_event_id": "authipay_webhook_refund_return"
   },
   "assert": {
    "source_verified": {
     "equals": true
    },
    "event_type": {
     "one_of": [
      "WEBHOOK_REFUND_SUCCESS"
     ]
    }
   },
   "display_name": "Handle Event | Refund via txntype RETURN notification"
  },
  "webhook_unknown_hash_algorithm": {
   "grpc_req": {
    "request_details": {
     "method": "HTTP_METHOD_POST",
     "headers": {
      "content-type": "application/x-www-form-urlencoded"
     },
     "body": ""
    },
    "merchant_event_id": "authipay_webhook_bad_algo"
   },
   "assert": {
    "source_verified": {
     "must_not_exist": true
    },
    "event_content": {
     "must_not_exist": true
    },
    "event_type": {
     "must_not_exist": true
    },
    "error": {
     "must_exist": true
    }
   },
   "display_name": "Handle Event | unknown hash_algorithm refused"
  }
 }
}
