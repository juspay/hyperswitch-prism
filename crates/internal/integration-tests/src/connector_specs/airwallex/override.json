{
  "PaymentService/Authorize": {
    "no3ds_auto_capture_credit_card": {
      "grpc_req": {
        "request_extended_authorization": true
      }
    }
  },
  "PaymentMethodAuthenticationService/PreAuthenticate": {
    "threeds_card_pre_authenticate": {
      "assert": {
        "status": null,
        "error": null,
        "error.error_code": {
          "contains": "MISSING_REQUIRED_FIELD"
        },
        "error.error_message": {
          "contains": "connector_order_id"
        }
      }
    }
  }
}
