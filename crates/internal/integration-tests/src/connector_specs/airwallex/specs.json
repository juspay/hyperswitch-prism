{
  "connector": "airwallex",
  "supported_suites": [
    "PaymentService/Authorize",
    "PaymentService/Capture",
    "CustomerService/Create",
    "PaymentService/CreateOrder",
    "PaymentService/Get",
    "RecurringPaymentService/Charge",
    "PaymentService/Refund",
    "RefundService/Get",
    "MerchantAuthenticationService/CreateServerAuthenticationToken",
    "PaymentService/SetupRecurring",
    "PaymentService/Void"
  ],
  "supported_payment_methods": [
    "card",
    "ideal",
    "klarna"
  ],
  "unsupported_scenarios": {
    "PaymentService/Authorize": {
      "threeds_manual_capture_credit_card": "Airwallex 3DS requires a browser-based redirect flow; no browser_automation_spec.json is configured for Airwallex",
      "no3ds_manual_capture_incremental_auth": "IncrementalAuthorization is not_implemented for Airwallex"
    }
  }
}
