# GRACE connector supervisor. Linux only.
#
#   cp grace-supervisor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now grace-supervisor
#   journalctl --user -u grace-supervisor -f
#
# Watch the connector currently running:  tmux attach -t grace-<connector>
[Unit]
Description=GRACE connector supervisor (one connector at a time)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hyperswitch-prism
ExecStart=/usr/bin/python3 %h/hyperswitch-prism/grace/scripts/grace_supervisor.py \
          --config %h/hyperswitch-prism/grace/scripts/queue.json

# Restart is safe: the ledger is run_id-scoped, so a restart resumes the queue
# and skips connectors already recorded success for this run rather than
# redoing them. It never resumes a HALTED queue though — exit 2 means a dirty
# tree or disk, which repeats for every connector, so stop and let a human look.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=60

# A connector run takes hours; never let systemd interrupt one.
TimeoutStopSec=300
KillSignal=SIGTERM

[Install]
WantedBy=default.target
