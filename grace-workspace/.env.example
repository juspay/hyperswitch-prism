# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Anything set here overrides the corresponding field in config.yml,
# but is itself overridden by an already-exported shell env var.

# Absolute path to the target repo (the one 10XGRACE will run pipelines against).
# Required if config.yml's projectRoot doesn't point at a real directory.
# Also used by Parity Autopilot as the default PRISM path.
TENXGRACE_PROJECT_ROOT=/absolute/path/to/hyperswitch-prism

# Absolute path to the connector creds.json. SessionManager symlinks this
# into every newly-created session worktree as `<worktree>/creds.json`,
# so the grpc-server and agents find creds at the path preflight checks
# without you having to copy the file into each worktree.
# Also used by Parity Autopilot when booting prism's grpc-server in VERIFY.
TENXGRACE_CREDS_PATH=/absolute/path/to/creds.json

# LLM gateway credentials. Leave blank to fall back to config.yml's llm.* block.
TENXGRACE_LLM_API_KEY=
TENXGRACE_LLM_BASE_URL=
TENXGRACE_LLM_MODEL=

# ─── Parity Autopilot ────────────────────────────────────────────────────────
# Only two extra paths are needed for the Parity Autopilot beyond what's already
# set above. PRISM_PATH and CREDS_PATH fall back to TENXGRACE_PROJECT_ROOT and
# TENXGRACE_CREDS_PATH respectively — don't repeat them here.

# Absolute path to a hyperswitch clone — the OUTGOING side of UCS. Required
# when a parity leaf's locus comes back as "hs-bridge" (diff originates in the
# UCS bridge serializer at crates/external_services/src/grpc_client/
# unified_connector_service.rs). Without this set, hs-bridge leaves escalate.
# PRs are opened against juspay/hyperswitch (not juspay/hyperswitch-prism).
#
# Setup: git clone https://github.com/juspay/hyperswitch
#        cd hyperswitch && cargo build -p external_services    # verify
#        export PARITY_BRIDGE_PATH=$PWD
# PARITY_BRIDGE_PATH=/absolute/path/to/hyperswitch

# Read-only hyperswitch clone for oracle reference under crates/hyperswitch_connectors/
# etc. Typically the SAME path as PARITY_BRIDGE_PATH unless you're experimenting
# with a fork.
# PARITY_ORACLE_PATH=/absolute/path/to/hyperswitch
