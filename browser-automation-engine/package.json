{
  "name": "browser-automation-engine",
  "version": "0.1.0",
  "private": true,
  "description": "JSON-DSL browser automation runtime on top of Playwright",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bash scripts/run-worker.sh",
    "cli": "bash scripts/run-worker.sh",
    "gpay": "tsx src/gpay-token-gen.ts",
    "gpay:login": "tsx src/gpay-login.ts",
    "apay": "tsx src/applepay-token-gen.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "bash scripts/run-worker.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "install:browsers": "playwright install chromium webkit",
    "test": "tsx --test test/*.test.ts",
    "test:container": "tsx --test test/container.integration.ts",
    "build:worker": "bash scripts/build-worker.sh"
  },
  "dependencies": {
    "netlify": "^24.3.0",
    "playwright": "^1.53.0",
    "selenium-webdriver": "^4.41.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/selenium-webdriver": "^4.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
