<!--
  jOOQ codegen config for the two plugin tables. Apply ddl.sql to a local MySQL/MariaDB named `killbill`,
  then run:  mvn -Pgenerate-jooq generate-sources
  This regenerates src/main/java/org/killbill/billing/plugin/hyperswitch/dao/gen/**; commit the output.
-->
<configuration>
    <jdbc>
        <driver>com.mysql.cj.jdbc.Driver</driver>
        <url>jdbc:mysql://127.0.0.1:3306/killbill</url>
        <user>root</user>
        <password>root</password>
    </jdbc>
    <generator>
        <database>
            <name>org.jooq.meta.mysql.MySQLDatabase</name>
            <includes>hyperswitch_.*</includes>
            <inputSchema>killbill</inputSchema>
        </database>
        <target>
            <packageName>org.killbill.billing.plugin.hyperswitch.dao.gen</packageName>
            <directory>src/main/java/</directory>
        </target>
    </generator>
</configuration>
