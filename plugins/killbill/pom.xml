<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kill-bill.billing</groupId>
        <artifactId>killbill-oss-parent</artifactId>
        <version>0.146.63</version>
    </parent>
    <groupId>org.kill-bill.billing.plugin.java</groupId>
    <artifactId>hyperswitch-plugin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <name>Kill Bill Hyperswitch Prism plugin</name>
    <description>Kill Bill payment plugin that routes payments through Hyperswitch Prism (any connector via one integration)</description>
    <url>https://github.com/juspay/hyperswitch-prism/tree/main/plugins/killbill</url>

    <properties>
        <check.fail-spotbugs>false</check.fail-spotbugs>
        <!-- The plugin requires JDK 17+ because io.hyperswitch:prism does; confirm the KillBill runtime matches -->
        <maven.compiler.release>17</maven.compiler.release>
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <!-- Everything under this package is Private-Package'd into the bundle -->
        <osgi.private>org.killbill.billing.plugin.hyperswitch.*</osgi.private>
    </properties>

    <dependencies>

        <!-- ============================ Jackson (additional_data (de)serialization) ============================ -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ============================ Common utilities ============================ -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <!-- The plugin builds/reads Prism proto messages directly (types.Payment.*), so protobuf-java is a
             direct dependency; the version must match the one the SDK's generated stubs were built with. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.33.4</version>
        </dependency>
        <!-- ============================ Hyperswitch Prism SDK (embedded, in-process — same model as plugins/medusa) ============================ -->
        <!--
            io.hyperswitch:prism uses JNA to load a native Rust lib (connector_service_ffi) for request/response
            transformation, plus protobuf-java + OkHttp for the outbound processor call. It is the Java analog of
            the Node `hyperswitch-prism` SDK that the Medusa plugin embeds.

            MUST VERIFY during the P0 spike (see README):
              1. the published artifact's package names (in-repo examples use `payments.*` / `types.Payment.*`;
                 the SDK README advertises `com.hyperswitch.payments.*`);
              2. that the jar bundles a native lib for the target platform (linux x64/arm64) — if not, build the
                 FFI from source in CI and place it on the JNA path.
        -->
        <dependency>
            <groupId>io.hyperswitch</groupId>
            <artifactId>prism</artifactId>
            <!-- Built from the in-repo sdk/java (VERSION=0.3.0-local ./gradlew publishToMavenLocal) so the
                 plugin compiles against the same generated API as the bundled native FFI. The published
                 Maven Central jars do not bundle a native lib, so a local build is required either way. -->
            <version>0.3.0-local</version>
        </dependency>

        <!-- Servlet API for the webhook endpoint -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
        </dependency>
        <dependency>
            <groupId>joda-time</groupId>
            <artifactId>joda-time</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OSGi framework (provided by the KillBill runtime) -->
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.framework</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jooby: KillBill plugin servlet routing (used by PluginAppBuilder) -->
        <dependency>
            <groupId>org.jooby</groupId>
            <artifactId>jooby</artifactId>
        </dependency>

        <!-- DB-less: no jOOQ. Connector state is persisted in KillBill's own storage (custom fields + core
             Payment API) via HyperswitchStateStore. -->

        <!-- ============================ KillBill APIs (provided by the runtime) ============================ -->
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-platform-osgi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-platform-osgi-bundles-lib-killbill</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing</groupId>
            <artifactId>killbill-platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing.plugin</groupId>
            <artifactId>killbill-plugin-api-notification</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.billing.plugin</groupId>
            <artifactId>killbill-plugin-api-payment</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The framework base: PluginPaymentPluginApi, PluginPaymentDao, PluginPaymentTransactionInfoPlugin, etc. -->
        <dependency>
            <groupId>org.kill-bill.billing.plugin.java</groupId>
            <artifactId>killbill-base-plugin</artifactId>
        </dependency>

        <!-- ============================ Test ============================ -->
        <dependency>
            <groupId>org.kill-bill.billing.plugin.java</groupId>
            <artifactId>killbill-base-plugin</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-clock</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-clock</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-embeddeddb-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-metrics-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.kill-bill.commons</groupId>
            <artifactId>killbill-utils</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Activator>org.killbill.billing.plugin.hyperswitch.HyperswitchActivator</Bundle-Activator>
                        <!--
                            Embed the Prism SDK and its runtime stack into the bundle jar (they are NOT provided by
                            the KillBill OSGi runtime). Adjust artifactIds to match the SDK's actual transitive deps.
                            The native lib inside the SDK jar rides along; JNA extracts it at runtime.
                        -->
                        <!-- Embed every compile/runtime dep (standard KillBill plugin pattern): the container only provides
                             the `provided`-scope APIs, so killbill-base-plugin, jOOQ, the Prism SDK and its whole
                             transitive stack must all ride inside the bundle. -->
                        <Embed-Dependency>*;scope=compile|runtime;inline=false</Embed-Dependency>
                        <Embed-Transitive>true</Embed-Transitive>
                        <!-- Do not try to import the SDK's internal packages or JNA natives from the OSGi container -->
                        <Import-Package>!com.hyperswitch.*,
                            !payments.*,
                            !types.*,
                            !com.sun.jna.*,
                            !okhttp3.*,
                            !okio.*,
                            !kotlin.*,
                            !org.killbill.billing.plugin.api.*,
                            !org.killbill.billing.plugin.core.*,
                            !org.killbill.billing.plugin.dao.*,
                            !org.killbill.billing.plugin.util.*,
                            javax.servlet.*;resolution:=optional,
                            org.killbill.*,
                            org.slf4j.*;version="[1.7,3)",
                            org.osgi.framework.*,
                            org.osgi.service.log.*;resolution:=optional,
                            *;resolution:=optional</Import-Package>
                        <Private-Package>org.killbill.billing.plugin.hyperswitch.*</Private-Package>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <rules>
                        <requireUpperBoundDeps>
                            <excludes>
                                <!-- Pulled transitively by io.hyperswitch:prism (okhttp/kotlin stack); the SDK
                                     and its deps are embedded wholesale into the bundle, so KillBill's
                                     upper-bound rule doesn't apply to them. -->
                                <exclude>org.jetbrains.kotlin:kotlin-stdlib</exclude>
                                <exclude>org.jetbrains.kotlin:kotlin-stdlib-jdk8</exclude>
                                <exclude>org.jetbrains.kotlin:kotlin-stdlib-jdk7</exclude>
                                <exclude>org.jetbrains.kotlin:kotlin-stdlib-common</exclude>
                                <exclude>com.google.protobuf:protobuf-java</exclude>
                                <exclude>com.squareup.okhttp3:okhttp</exclude>
                                <exclude>com.squareup.okio:okio</exclude>
                                <exclude>net.java.dev.jna:jna</exclude>
                                <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                <exclude>com.google.code.gson:gson</exclude>
                            </excludes>
                        </requireUpperBoundDeps>
                        <!-- The parent pins maxJdkVersion to KillBill's own Java 11 target; this plugin requires a
                             JDK 17 runtime (io.hyperswitch:prism is compiled to bytecode 61), so raise the cap. -->
                        <enforceBytecodeVersion>
                            <maxJdkVersion>17</maxJdkVersion>
                        </enforceBytecodeVersion>
                    </rules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
