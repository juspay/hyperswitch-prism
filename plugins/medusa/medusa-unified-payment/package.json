{
  "name": "medusa-unified-payment-test",
  "version": "0.0.1",
  "description": "Unified payment provider for Medusa v2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc --project ../tsconfig.json",
    "watch": "tsc --watch --project ../tsconfig.json",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPatterns=integration",
    "test:coverage": "jest --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.15.0"
  },
  "dependencies": {
    "hyperswitch-prism": "latest",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@medusajs/framework": "^2.15.0",
    "@types/jest": "^30.0.0",
    "@types/express": "^4.17.21",
    "jest": "^30.4.2",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0"
  },
  "homepage": "https://github.com/juspay/medusa-hyperswitch-prism/blob/main/medusa-unified-payment/README.md",
  "keywords": [
    "medusa-plugin",
    "medusa-plugin-payment",
    "medusa-plugin-integration",
    "medusa-v2",
    "medusa",
    "medusajs",
    "payment",
    "hyperswitch",
    "prism",
    "stripe",
    "adyen",
    "paypal",
    "globalpay",
    "braintree",
    "cybersource",
    "mollie",
    "unified-payment"
  ],
  "files": [
    "dist",
    "README.md"
  ]
}