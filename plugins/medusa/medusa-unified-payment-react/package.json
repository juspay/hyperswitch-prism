{
  "name": "@juspay-tech/medusa-unified-payment-react-test",
  "version": "0.0.3",
  "description": "Generic payment UI components for Medusa v2 storefronts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react,react-dom,@medusajs/js-sdk,@adyen/adyen-web,@stripe/react-stripe-js,@stripe/stripe-js",
    "watch": "tsup src/index.ts --format cjs,esm --dts --external react,@medusajs/js-sdk --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@adyen/adyen-web": "^6.0.0",
    "@medusajs/js-sdk": "^2.0.0",
    "@stripe/react-stripe-js": ">=2.0.0",
    "@stripe/stripe-js": ">=3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@adyen/adyen-web": {
      "optional": true
    },
    "@stripe/react-stripe-js": {
      "optional": true
    },
    "@stripe/stripe-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adyen/adyen-web": "^6.37.0",
    "@stripe/react-stripe-js": ">=2.0.0",
    "@stripe/stripe-js": ">=3.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "medusa",
    "payment",
    "adyen",
    "stripe",
    "paypal"
  ],
  "license": "MIT"
}
