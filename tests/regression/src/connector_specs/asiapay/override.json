{
  "PaymentService/Authorize": {
    "no3ds_auto_capture_credit_card": {
      "assert": {
        "status": {
          "equals": "AUTHENTICATION_PENDING"
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "error": {
          "must_not_exist": true
        },
        "redirection_data.html.html_data": {
          "must_exist": true
        }
      }
    },
    "no3ds_auto_capture_debit_card": {
      "assert": {
