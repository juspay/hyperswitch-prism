        }
      }
    }
  },
  "PaymentService/VerifyRedirectResponse": {
    "verify_redirect_basic": {
      "depends_on": [],
      "grpc_req": {
        "request_details": {
          "uri": "https://example.com/payment/redirect?Ref=order%2Fref",
          "query_params": "Ref=order%2Fref"
        }
      },
      "assert": {
        "source_verified": {
          "equals": false
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "merchant_order_id": {
          "must_exist": true
        },
        "error": null
      }
    },
    "verify_redirect_with_params": {
      "depends_on": [],
      "grpc_req": {
        "request_details": {
          "uri": "https://example.com/payment/redirect?Ref=order+with+space&result=ignored",
          "query_params": "Ref=order+with+space&result=ignored"
        }
      },
      "assert": {
        "source_verified": {
          "equals": false
        },
        "connector_transaction_id": {
          "must_exist": true
        },
        "merchant_order_id": {
          "must_exist": true
        },
        "error": null
      }
    }
  }
