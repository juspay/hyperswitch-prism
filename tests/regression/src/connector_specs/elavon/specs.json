{
  "connector": "elavon",
  "supported_suites": [
    "PaymentService/Authorize",
    "PaymentService/Capture",
    "PaymentService/Refund",
    "RefundService/Get",
    "PaymentService/Get",
    "RecurringPaymentService/Charge",
    "PaymentService/Void",
    "PaymentService/SetupRecurring",
    "PaymentService/IncrementalAuthorization"
  ],
  "request_id_source_field": "merchant_transaction_id",
  "suite_dependencies": {
    "RecurringPaymentService/Charge": {
      "replace": [
        {
          "suite": "PaymentService/Authorize",
          "scenario": "no3ds_auto_capture_credit_card_with_setup_future_usage",
          "context_map": {
            "payment_method.card_details_for_network_transaction_id.card_number": "req.payment_method.card.card_number",
            "payment_method.card_details_for_network_transaction_id.card_exp_month": "req.payment_method.card.card_exp_month",
            "payment_method.card_details_for_network_transaction_id.card_exp_year": "req.payment_method.card.card_exp_year",
            "connector_recurring_payment_id.network_mandate_id.network_transaction_id": "res.network_transaction_id",
            "connector_recurring_payment_id.network_mandate_id.transaction_link_id": "res.network_txn_link_id",
            "customer.id": "req.customer.id"
          }
        }
      ]
    },
    "PaymentService/Capture": {
      "replace": [
        "MerchantAuthenticationService/CreateServerAuthenticationToken",
        "MerchantAuthenticationService/CreateServerSessionAuthenticationToken",
        "CustomerService/Create",
        "PaymentMethodService/Tokenize",
        {
          "suite": "PaymentService/Authorize",
          "scenario": "no3ds_manual_capture_credit_card",
          "context_map": {
            "amount_to_capture.currency": "req.amount.currency"
          }
        }
      ]
    }
  },
  "supported_payment_methods": [
    "card"
  ]
}
