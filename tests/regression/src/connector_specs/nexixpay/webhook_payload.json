{
  "_webhook_config": {
    "webhook_secret_key": "nexixpay_fixture_security_token",
    "note": "Nexi XPay notifications carry no signature header, and the only authenticity anchor XPay documents is a per-transaction securityToken issued at order initialisation through HPP / Build / PayByLink / googlepay (techspec Webhook Events, Webhook Authentication & Signature Verification). The S2S 3steps flow returns no such token and UCS holds no per-transaction state, so the connector cannot verify a notification statelessly: source_verified is always false and Hyperswitch confirms state via PSync / RSync. Bodies are the documented notification example (techspec Webhook Payload Structure) with operationType/operationResult varied per scenario. In the three positive scenarios webhook_secrets.secret equals the body securityToken (the documented example value, a published sample and not a credential) to pin that a matching static secret does NOT verify; invalid_signature sends a securityToken that differs from it. webhook_secret_key names a key absent from creds.json so the harness never injects a secret.",
    "signature_algorithm": "none (Nexi signs nothing; per-transaction securityToken not available to UCS, so source_verified is always false)"
  },
