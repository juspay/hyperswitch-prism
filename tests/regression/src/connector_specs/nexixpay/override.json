{
  "PaymentMethodAuthenticationService/PreAuthenticate": {
    "threeds_card_pre_authenticate": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4349940199004549"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_exp_year": {
              "value": "30"
            },
            "card_cvc": {
              "value": "123"
            }
          }
        }
      },
      "assert": {
        "redirection_data.form.endpoint": {
          "must_exist": true
        },
        "redirection_data.form.form_fields.ThreeDsRequest": {
          "must_exist": true
        },
        "redirection_data.form.form_fields.ReturnUrl": {
          "must_exist": true
        },
        "redirection_data.form.form_fields.transactionId": {
          "must_exist": true
        }
      }
    }
  },
  "PaymentMethodAuthenticationService/Authenticate": {
    "threeds_card_authenticate": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4349940199004549"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_exp_year": {
              "value": "30"
            },
            "card_cvc": {
              "value": "123"
            }
          }
        }
      }
    }
  },
  "PaymentMethodAuthenticationService/PostAuthenticate": {
    "threeds_card_post_authenticate": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4349940199004549"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_exp_year": {
              "value": "30"
            },
            "card_cvc": {
              "value": "123"
            }
          }
        },
        "redirection_response": {
          "payload": {
            "PaRes": "auto_generate",
            "paymentId": "auto_generate"
          }
        }
      }
    }
  },
  "PaymentService/Authorize": {
    "no3ds_auto_capture_credit_card": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        }
      },
      "assert": {
        "status": null,
        "connector_transaction_id": null,
        "error": {
          "must_exist": true
        }
      }
    },
    "threeds_manual_capture_credit_card": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4111111111111111"
            },
            "card_exp_month": {
              "value": "08"
            },
            "card_exp_year": {
              "value": "35"
            },
            "card_cvc": {
              "value": "999"
            }
          }
        }
      }
    }
  },
  "PaymentService/Void": {
    "void_authorized_payment": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    },
    "void_without_cancellation_reason": {
      "grpc_req": {
        "amount": {
          "minor_amount": 6000,
          "currency": "USD"
        }
      }
    }
  },
  "PaymentService/CompleteAuthorize": {
    "threeds_complete_authorize_credit_card": {
      "grpc_req": {
        "amount": {
          "minor_amount": 100,
          "currency": "EUR"
        },
        "payment_method": {
          "card": {
            "card_number": {
              "value": "4349940199004549"
            },
            "card_exp_month": {
              "value": "12"
            },
            "card_exp_year": {
              "value": "30"
            },
            "card_cvc": {
              "value": "123"
            }
          }
        }
      }
    }
  },
  "PaymentService/SetupRecurring": {
    "setup_recurring": {
      "grpc_req": {
        "auth_type": "THREE_DS",
        "complete_authorize_url": "https://example.com/payment/complete",
        "amount": {
          "currency": "EUR"
        }
      }
    },
    "setup_recurring_with_webhook": {
      "grpc_req": {
        "auth_type": "THREE_DS",
        "complete_authorize_url": "https://example.com/payment/complete",
        "amount": {
          "currency": "EUR"
        }
      }
    },
    "setup_recurring_with_order_context": {
      "grpc_req": {
        "auth_type": "THREE_DS",
        "complete_authorize_url": "https://example.com/payment/complete",
        "amount": {
          "currency": "EUR"
        }
      }
    }
  },
  "EventService/HandleEvent": {
    "payment_succeeded": {
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null,
        "event_content.payments_response.status": {
          "one_of": [
            "CHARGED"
          ]
        }
      }
    },
    "payment_failed": {
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null,
        "event_content.payments_response.status": {
          "one_of": [
            "FAILURE"
          ]
        }
      }
    },
    "refund_succeeded": {
      "assert": {
        "source_verified": {
          "must_not_exist": true
        },
        "event_status": null,
        "event_content.refunds_response.status": {
          "one_of": [
            "REFUND_SUCCESS"
          ]
        }
      }
    },
    "invalid_signature": {
      "assert": {
        "event_status": null,
        "event_type": {
          "one_of": [
            "PAYMENT_INTENT_SUCCESS",
            "PAYMENT_INTENT_CAPTURE_SUCCESS"
          ]
        }
      }
    }
  }
}
